{
  "name": "@musubi/hub-sdk",
  "version": "1.0.0",
  "description": "TypeScript Control Hub SDK (JSON-RPC 2.0, WS/SSE/poll transports)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./electron": {
      "import": {
        "types": "./dist/electron.d.ts",
        "default": "./dist/electron.mjs"
      },
      "require": {
        "types": "./dist/electron.d.cts",
        "default": "./dist/electron.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node detonate.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "control-hub",
    "json-rpc",
    "websocket",
    "sse",
    "sdk",
    "harmonyos"
  ]
}